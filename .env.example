# SnapList runtime configuration. Copy to .env and edit.

# Bind host/port. 127.0.0.1 = local only. LAN mode is opt-in (see below).
HOST=127.0.0.1
PORT=8000

# Offline / local-first AI. "mock" runs the whole flow without network or keys.
# "litellm" routes to Ollama / OpenAI-compatible / Anthropic / Gemini via ONE call shape.
LLM_PROVIDER=litellm
VISION_MODEL=gemma3:4b
TEXT_MODEL=gemma3:4b

# LiteLLM backend. Leave blank to use provider defaults (e.g. Ollama at http://localhost:11434).
# LITELLM_BASE_URL=http://localhost:11434
# LITELLM_API_KEY=ollama

# --- OpenRouter (free-tier models) ---
# Set LLM_PROVIDER=litellm and use these to route through OpenRouter free models:
# VISION_MODEL=openrouter/meta-llama/llama-4-scout
# TEXT_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# LITELLM_BASE_URL=https://openrouter.ai/api/v1
# LITELLM_API_KEY=sk-or-...

# Off-machine (cloud) use is opt-in, per job, and the UI flags it.
CLOUD_VISION_ENABLED=false
CLOUD_TEXT_ENABLED=false
CLOUD_VISION_MODEL=claude-3-5-sonnet-latest
CLOUD_TEXT_MODEL=claude-3-5-sonnet-latest

# Secret storage for tokens (keyring with env fallback).
SECRET_KEY_NAME=snaplist_secret
